{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "apps/frontend/dist/JohanDev/browser",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
