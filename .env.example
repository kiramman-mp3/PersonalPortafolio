# Variables de entorno requeridas en Vercel
# Configúralas en Vercel Dashboard -> Project Settings -> Environment Variables

# Cadena de conexión PostgreSQL (Recomendado Neon, Supabase o Railway)
DATABASE_URL="postgresql://usuario:contrasena@host:5432/nombre_db?sslmode=require"

# Clave secreta para operaciones administrativas de la API (x-api-key)
API_KEY="tu_clave_secreta_aqui"

# Contraseña de acceso al panel /admin
ADMIN_PASSWORD="tu_contrasena_de_administrador"

# Entorno
NODE_ENV="production"
