# =============================================================================
# Variables de entorno para JohanDev Portfolio (Despliegue en Vercel y Local)
# =============================================================================
# En Vercel: Configúralas en Vercel Dashboard -> Project Settings -> Environment Variables
# En Local: Copia este archivo a apps/api/.env

# Cadena de conexión PostgreSQL (Recomendado Neon, Supabase o Railway con pooler/pgbouncer)
DATABASE_URL="postgresql://usuario:contrasena@host:5432/nombre_db?sslmode=require"

# Clave secreta para operaciones administrativas de la API (x-api-key)
API_KEY="tu_clave_secreta_aqui"

# Contraseña de acceso al panel /admin del portafolio
ADMIN_PASSWORD="tu_contrasena_de_administrador"

# Entorno de ejecución
NODE_ENV="production"
